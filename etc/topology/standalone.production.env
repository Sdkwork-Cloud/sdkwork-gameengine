SDKWORK_GAMES_PROFILE_ID=standalone.production
SDKWORK_GAMES_DEPLOYMENT_PROFILE=standalone
SDKWORK_GAMES_ENVIRONMENT=production
SDKWORK_GAMES_RUNTIME_TARGET=server
VITE_SDKWORK_GAMES_DEPLOYMENT_PROFILE=standalone
VITE_SDKWORK_GAMES_RUNTIME_TARGET=browser
SDKWORK_GAMES_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:8095
SDKWORK_GAMES_APPLICATION_PUBLIC_HTTP_URL=https://gameengine.sdkwork.com
VITE_SDKWORK_GAMES_APPLICATION_PUBLIC_HTTP_URL=https://gameengine.sdkwork.com
SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=db.games.internal
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_prod
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_prod
SDKWORK_DATABASE_USERNAME=sdkwork_ai_prod
SDKWORK_DATABASE_PASSWORD_FILE=/run/secrets/sdkwork/games/database-password
SDKWORK_DATABASE_SSL_MODE=require
SDKWORK_DATABASE_MAX_CONNECTIONS=32
SDKWORK_DATABASE_AUTO_MIGRATE=false


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_GAMES_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
